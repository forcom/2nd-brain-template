// Hand-authored rules. NOT regenerated by generate_logic_policy.py.
//
// logic-policy.md's DSL can only emit a conjunction of relation() atoms that all
// share the same subject X, so two rules it states in prose cannot be expressed
// there — both need a join across two subjects. They are written out here.

// An annex item is in the certification scope because the ANNEX it belongs to is
// normative — the status sits on the annex, not on the item, so the generated
// rule (which demands annex_status on the item itself) is not the real test.
.decl normative_annex_item(entity: symbol, reason: symbol)
normative_annex_item(X, "belongs_to_normative_annex") :-
  relation(X, "belongs_to_annex", A),
  relation(A, "annex_status", "normative").

// The main-body clause that makes a normative annex binding, surfaced per item so
// an auditor can trace an individual control back to the clause that requires it.
.decl annex_item_binding_clause(entity: symbol, reason: symbol)
annex_item_binding_clause(X, "bound_by_main_body_clause") :-
  relation(X, "belongs_to_annex", A),
  relation(A, "annex_status", "normative"),
  relation(A, "made_binding_by", _).

// A clause of an HLS standard and a clause of an HS standard are one integration
// point when their slots are declared equivalent, even though the numbers differ.
.decl cross_structure_pair(entity: symbol, reason: symbol)
cross_structure_pair(X, "hs_hls_equivalent_slot") :-
  relation(X, "maps_to_hls", S),
  relation(S, "slot_equivalent_to", _).

// --- 2026-09-04: 생성된 logic-policy.dl 의 두 규칙이 산문을 구현하지 못해 손으로 다시 씀 ---
//
// logic-policy.md 의 DSL 은 "같은 주어 X 를 공유하는 relation() 논리곱"만 생성할 수 있다.
// 그래서 아래 두 규칙은 생성기가 표현할 수 없고, 생성된 형태는 산문과 다른 것을 계산한다.
// 생성된 policy_match(X,"certification_mandatory") / policy_match(X,"hls_strictest_wins")
// 는 그대로 남아 있으나 각각 항상-0행 / 무의미한 표식이므로 신뢰하지 말 것.

// [certification_mandatory] 산문: "obligation 이 shall 이거나, annex_status 가 normative 일 때".
// 생성된 규칙은 두 relation 을 모두 요구하는 논리곱(AND)이고 값 검사도 없어서, 두 relation 을
// 동시에 가진 주어가 없는 한 영원히 0행이다. 선언(OR)은 머리를 공유하는 두 규칙으로 쓴다.
// "only should/may/can 은 필수가 아니다"라는 단서는 shall 분기에 걸리지 않는 것으로 자동 충족된다.
.decl certification_mandatory(entity: symbol, reason: symbol)
certification_mandatory(X, "shall_obligation") :-
  relation(X, "obligation", "shall").
certification_mandatory(X, "normative_annex") :-
  relation(X, "annex_status", "normative").

// [hls_strictest_wins] 산문: 같은 구조 슬롯을 공유하는 조항들이 서로 다른 obligation 수준을
// 가지면 가장 엄격한 것을 따르며, 형제 표준이 약하게 진술한다고 낮추지 않는다.
// 생성된 규칙은 relation(X,"obligation",_) 하나뿐이라 "obligation 을 가진 모든 주어"를 셀 뿐,
// 슬롯 조인도 수준 비교도 하지 않는다. 강도 순서를 명시적 EDB 로 두고 조인한다.
.decl weaker_than(lower: symbol, higher: symbol)
weaker_than("should", "shall").
weaker_than("may", "shall").
weaker_than("can", "shall").
weaker_than("may", "should").
weaker_than("can", "should").
weaker_than("can", "may").

// 약하게 진술된 쪽(Y)을 표시한다 — 통합 시스템에서 끌어올려야 하는 조항이 그쪽이기 때문이다.
.decl hls_strictest_wins(entity: symbol, reason: symbol)
hls_strictest_wins(Y, "sibling_clause_states_it_more_strictly") :-
  relation(X, "maps_to_hls", S),
  relation(Y, "maps_to_hls", S),
  relation(X, "obligation", H),
  relation(Y, "obligation", L),
  weaker_than(L, H),
  X != Y.

// --- 2026-09-11: 생성된 규칙 두 건이 더 퇴화해 손으로 다시 씀 ---

// [structure_family_read_not_inferred] 산문: structure_family 는 표준 자신의 본문에서 와야 하며,
// 둘 중 어느 표기도 없는 표준은 발행연도로 계열을 배정하지 말고 review 로 보고한다.
// 생성된 규칙은 relation(X,"structure_family",_) 하나라 "structure_family 를 가진 모든 주어"를
// 지목한다 — 지목 대상이 정확히 반대다. 본문 선언이 있어 수락된 표준이 걸리고, 정작 선언이 없는
// 표준은 needs_review 라 accepted.dl 에 없으므로 걸리지 않는다.
// 엔진이 볼 수 있는 형태로 바꾸면: 조항을 가진 주어(=표준) 중 structure_family 가 하나도 없는 것.
// 부정보다 앞선 긍정 술어가 X 를 묶는다(층화 안전). 보조 술어는 두지 않는다 — 리포터가
// arity-2 (entity, reason) 술어만 다루므로 arity-1 헬퍼를 선언하면 리포터가 죽는다.
.decl structure_family_read_not_inferred(entity: symbol, reason: symbol)
structure_family_read_not_inferred(X, "body_declares_no_structure_family") :-
  relation(X, "has_clause", _),
  !relation(X, "structure_family", _).

// [edition_currency] 산문: 한 표준이 다른 표준을 supersede 하면 요구사항은 신판에서 읽으며,
// 폐지판에서만 인용된 조항은 현행으로 취급하지 말고 review 로 보고한다.
// 생성된 규칙은 relation(X,"supersedes",_) 라서 폐지된 쪽이 아니라 폐지한 쪽(신판)을 지목한다.
// 지목 대상은 조항이며, 코퍼스에서는 KS 번역본이 근거로 삼은 ISO 판이 폐지되는 경로가 실제로 쓰인다.
.decl edition_currency(entity: symbol, reason: symbol)
edition_currency(C, "clause_of_superseded_edition") :-
  relation(S, "has_clause", C),
  relation(_, "supersedes", S).
edition_currency(C, "based_on_superseded_edition") :-
  relation(K, "has_clause", C),
  relation(K, "based_on", I),
  relation(_, "supersedes", I).

// --- 2026-09-11: 타입 레이어 (온톨로지 쿼리의 전제) ---
//
// 엔터티 647개의 종류가 지금까지 문자열 모양으로만 구분됐다 — "…A.10.1.1" 이 부속서 항목이라는
// 것은 정규식이 아는 것이지 KB 가 아는 것이 아니었다. 타입을 사실에서 결정적으로 파생시켜,
// 정책 규칙과 질의가 문자열 패턴 대신 타입으로 조건을 걸 수 있게 한다.
// 새 사실을 추출하지 않는다 — 기존 accepted 사실만으로 엔진이 도출한다.
//
// 리포터가 arity-2 (entity, reason) 만 다루므로 reason 자리에 타입 이름을 둔다.
// 재귀를 피하려고 조건은 인라인한다(instance_of 를 몸통에 쓰지 않는다).
.decl instance_of(entity: symbol, reason: symbol)

// 표준 — 부속서를 갖거나, 판본 계보에 참여하는 것. 구조 문서는 부속서가 없어 섞이지 않는다.
instance_of(S, "standard") :- relation(S, "has_annex", _).
instance_of(S, "standard") :- relation(S, "edition_year", _).
instance_of(S, "standard") :- relation(S, "based_on", _).
instance_of(S, "standard") :- relation(_, "based_on", S).
instance_of(S, "standard") :- relation(S, "supersedes", _).
instance_of(S, "standard") :- relation(_, "supersedes", S).
instance_of(S, "standard") :- relation(S, "amended_by", _).
instance_of(S, "standard") :- relation(_, "amended_by", S).

// 구조 문서 — 자기 조항이 슬롯인 것(HLS/HS 원문).
instance_of(D, "structure_document") :-
  relation(D, "has_clause", C),
  relation(_, "maps_to_hls", C).

// 구조 슬롯 — maps_to_hls 의 목적어이거나 slot_equivalent_to 의 양 끝.
instance_of(T, "structure_slot") :- relation(_, "maps_to_hls", T).
instance_of(T, "structure_slot") :- relation(T, "slot_equivalent_to", _).
instance_of(T, "structure_slot") :- relation(_, "slot_equivalent_to", T).

// 조항 — 표준(부속서를 가진 것)의 has_clause 목적어. 구조 문서의 슬롯은 제외된다.
instance_of(C, "clause") :-
  relation(S, "has_clause", C),
  relation(S, "has_annex", _).

// 부속서와 그 항목. 부속서 항목은 조항이기도 하므로 두 타입을 함께 갖는다(다중 타입 의도됨).
instance_of(A, "annex") :- relation(_, "has_annex", A).
instance_of(A, "annex") :- relation(_, "belongs_to_annex", A).
instance_of(I, "annex_item") :- relation(I, "belongs_to_annex", _).

// 타입을 쓰는 온톨로지 규칙의 첫 사례 — 문자열 패턴 대신 타입으로 조건을 건다.
// "인증 필수인 부속서 항목": 종래에는 주어가 "…A.x.y" 모양인지 정규식으로 봐야 했다.
.decl mandatory_annex_item(entity: symbol, reason: symbol)
mandatory_annex_item(X, "annex_item_and_certification_mandatory") :-
  instance_of(X, "annex_item"),
  certification_mandatory(X, _).
